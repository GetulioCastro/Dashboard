{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "**": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.pfx": "deny",
      "**/*.p12": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/.aws/credentials": "deny",
      "**/.kube/config": "deny",
      "**/*.kubeconfig": "deny",
      "**/terraform.tfstate": "deny",
      "**/terraform.tfstate.*": "deny",
      "**/*.tfvars": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.docker/config.json": "deny",
      "**/appsettings.Production.json": "deny",
      "**/appsettings.*.Production.json": "deny",
      "**/secrets.json": "deny"
    },
    "edit": {
      "**": "deny",
      ".opencode/**": "ask",
      "Dashboard.Core/**": "allow",
      "Dashboard.Data/**": "allow",
      "Dashboard.Data.Tests/**": "allow",
      "Dashboard.Web/**": "allow",
      "docs/**": "allow",
      "**/AGENTS.md": "allow",
      "opencode.json": "allow"
    },
    "bash": {
      "*": "ask",
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean -fdx*": "deny",
      "dotnet ef database drop*": "deny",
      "git push* --force*": "deny",
      "git push* -f*": "deny",
      "git push* * --force": "deny",
      "git push* * -f": "deny",
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "dotnet run*": "allow",
      "dotnet restore*": "allow",
      "dotnet format*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git add*": "allow",
      "git stash*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask"
    }
  }
}