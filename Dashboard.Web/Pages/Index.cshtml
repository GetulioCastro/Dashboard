@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard de Indicadores";

    var indicadores = new[]
    {
        "Atendimentos",
        "Consultas",
        "Exames",
        "Faturamento",
        "Produção Médica",
        "Despesas"
    };
}

<div class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Dashboard de Indicadores</h1>
            <p class="text-muted mb-0">
                Visão geral dos indicadores do MVP. Os valores serão exibidos quando as consultas de dados forem implementadas.
            </p>
        </div>
        <span class="badge text-bg-secondary align-self-start">Aguardando implementação dos dados</span>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var indicador in indicadores)
        {
            <div class="col">
                <section class="card h-100 shadow-sm" aria-label="@indicador">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title mb-0">@indicador</h2>
                        <div class="border border-2 border-secondary-subtle rounded-3 bg-body-secondary text-muted d-flex align-items-center justify-content-center text-center py-5 mt-3 flex-grow-1">
                            <span class="small">Aguardando dados</span>
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
</div>
