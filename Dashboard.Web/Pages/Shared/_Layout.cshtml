<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard de Indicadores</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dashboard.Web.styles.css" asp-append-version="true" />
</head>
<body data-bs-theme="light">
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">Dashboard de Indicadores</a>
                @if (IsSectionDefined("MenuLateral"))
                {
                    <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#menuLateral"
                            aria-controls="menuLateral" aria-expanded="false" aria-label="Alternar menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <div class="row g-0">
            @if (IsSectionDefined("MenuLateral"))
            {
                <aside id="menuLateral" class="col-lg-2 d-lg-block collapse bg-white border-end">
                    @RenderSection("MenuLateral")
                </aside>
            }
            <main role="main" class="@(IsSectionDefined("MenuLateral") ? "col-lg-10" : "col-12")">
                <div class="px-lg-3 pb-3">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dashboard de Indicadores - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>