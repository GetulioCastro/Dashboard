@page
@model Dashboard.Web.Pages.AtendimentosModel
@using Dashboard.Core.DTOs
@{
    ViewData["Title"] = "Atendimentos - Visão do Indicador";
    var visao = Model.Visao;
    var dimensaoAtiva = visao?.DimensaoAtiva ?? DimensaoVisao.Nenhuma;
    var formaAtiva = visao?.Forma ?? GraficoForma.Coluna;
    var rotuloDimensao = dimensaoAtiva == DimensaoVisao.Nenhuma ? null : dimensaoAtiva.ToString().ToLowerInvariant();
}

<div class="py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Atendimentos</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <h1 class="h3 mb-0">Atendimentos</h1>
        @if (Model.Periodo is not null)
        {
            <span class="badge text-bg-secondary">
                Período: @Model.Periodo?.Start.ToString("dd/MM/yyyy") a @Model.Periodo?.End.ToString("dd/MM/yyyy")
            </span>
        }
    </div>

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label for="filtro-inicio" class="form-label small mb-1">Data Inicial</label>
                    <input type="date" class="form-control form-control-sm" id="filtro-inicio" name="inicio"
                           value="@Model.Periodo?.Start.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3">
                    <label for="filtro-fim" class="form-label small mb-1">Data Final</label>
                    <input type="date" class="form-control form-control-sm" id="filtro-fim" name="fim"
                           value="@Model.Periodo?.End.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-6 d-flex flex-wrap gap-2">
                    <input type="hidden" name="dimensao" value="@rotuloDimensao" />
                    <input type="hidden" name="forma" value="@formaAtiva.ToString().ToLowerInvariant()" />
                    <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
                </div>
            </div>
        </div>
    </form>

    @if (Model.DadosIndisponiveis)
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5 alert-heading">Dados indisponíveis no momento</h2>
            <p class="mb-0">
                Não foi possível consultar a base de dados do SisacHTML5 para o indicador de Atendimentos.
                Nenhum valor foi estimado e nenhum dado demonstrativo foi apresentado.
            </p>
            <p class="mb-0 mt-2 small text-muted font-monospace">@Model.MensagemIndisponibilidade</p>
        </div>
    }
    else if (visao is not null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex align-items-baseline gap-2">
                <span class="ind-valor">@visao.ValorTotal.ToString("N0")</span>
                <span class="ind-unidade small">@visao.Unidade</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <div class="btn-group btn-group-sm" role="group" aria-label="Dimensão">
                    <a class="btn btn-outline-secondary @(dimensaoAtiva == DimensaoVisao.Nenhuma ? "active" : "")"
                       asp-page="/Atendimentos"
                       asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                       asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                       asp-route-forma="@formaAtiva.ToString().ToLowerInvariant()">Nenhuma</a>
                    @foreach (var dimensao in visao.DimensoesDisponiveis)
                    {
                        <a class="btn btn-outline-secondary @(dimensaoAtiva == dimensao ? "active" : "")"
                           asp-page="/Atendimentos"
                           asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                           asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                           asp-route-dimensao="@dimensao.ToString().ToLowerInvariant()"
                           asp-route-forma="@formaAtiva.ToString().ToLowerInvariant()">@dimensao</a>
                    }
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Forma do gráfico">
                    <a class="btn btn-outline-primary @(formaAtiva == GraficoForma.Coluna ? "active" : "")"
                       asp-page="/Atendimentos"
                       asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                       asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                       asp-route-dimensao="@rotuloDimensao">Coluna</a>
                    <a class="btn btn-outline-primary @(formaAtiva == GraficoForma.Linha ? "active" : "")"
                       asp-page="/Atendimentos"
                       asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                       asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                       asp-route-dimensao="@rotuloDimensao"
                       asp-route-forma="linha">Linha</a>
                    @if (dimensaoAtiva != DimensaoVisao.Nenhuma)
                    {
                        <a class="btn btn-outline-primary @(formaAtiva == GraficoForma.Donut ? "active" : "")"
                           asp-page="/Atendimentos"
                           asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                           asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                           asp-route-dimensao="@rotuloDimensao"
                           asp-route-forma="donut">Rosca</a>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="grafico-visao" id="grafico-visao" role="img" aria-label="Gráfico do indicador de Atendimentos"></div>
                <div class="mt-3" id="legenda-visao"></div>
            </div>
        </div>

        <script type="application/json" id="dados-visao">@Html.Raw(Model.DadosJson)</script>
    }
</div>

@section Scripts {
    <script src="~/js/atendimentos.js" asp-append-version="true"></script>
}
