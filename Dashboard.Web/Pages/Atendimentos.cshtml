@page
@model Dashboard.Web.Pages.AtendimentosModel
@using Dashboard.Core.DTOs
@using Dashboard.Web.Dados
@{
    ViewData["Title"] = "Atendimentos - Visão do Indicador";
    ViewData["MenuPaginaAtual"] = "atendimentos";
    var visao = Model.Visao;
    var dimensaoAtiva = visao?.DimensaoAtiva ?? DimensaoVisao.Nenhuma;
    var formaAtiva = visao?.Forma ?? GraficoForma.Coluna;
    var rotuloDimensao = dimensaoAtiva == DimensaoVisao.Nenhuma ? null : dimensaoAtiva.ToString().ToLowerInvariant();
}

@section MenuLateral {
    <partial name="_MenuLateral" model="(List<IndicadorDemonstracao>?)null" />
}

<div class="py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Atendimentos</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <h1 class="h3 mb-0">Atendimentos</h1>
        @if (Model.Periodo is not null)
        {
            <span class="badge text-bg-secondary">
                Período: @Model.Periodo?.Start.ToString("dd/MM/yyyy") a @Model.Periodo?.End.ToString("dd/MM/yyyy")
            </span>
        }
    </div>

    <form method="get" class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-6 col-md-3">
                    <label for="filtro-inicio" class="form-label small mb-1">Data Inicial</label>
                    <input type="date" class="form-control form-control-sm" id="filtro-inicio" name="inicio"
                           value="@Model.Periodo?.Start.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-3">
                    <label for="filtro-fim" class="form-label small mb-1">Data Final</label>
                    <input type="date" class="form-control form-control-sm" id="filtro-fim" name="fim"
                           value="@Model.Periodo?.End.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-6 d-flex flex-wrap gap-2">
                    <input type="hidden" name="dimensao" value="@rotuloDimensao" />
                    <input type="hidden" name="forma" value="@formaAtiva.ToString().ToLowerInvariant()" />
                    <button type="submit" class="btn btn-sm btn-primary">Aplicar</button>
                </div>
            </div>
        </div>
    </form>

    @if (Model.DadosIndisponiveis)
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5 alert-heading">Dados indisponíveis no momento</h2>
            <p class="mb-0">
                Não foi possível consultar a base de dados do SisacHTML5 para o indicador de Atendimentos.
                Nenhum valor foi estimado e nenhum dado demonstrativo foi apresentado.
            </p>
            <p class="mb-0 mt-2 small text-muted font-monospace">@Model.MensagemIndisponibilidade</p>
        </div>
    }
    else if (visao is not null)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex align-items-baseline gap-2">
                <span class="ind-valor">@visao.ValorTotal.ToString("N0")</span>
                <span class="ind-unidade small">@visao.Unidade</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <div class="btn-group btn-group-sm" role="group" aria-label="Dimensão">
                    @foreach (var dimensao in visao.DimensoesDisponiveis.Where(d => d != DimensaoVisao.Nenhuma))
                    {
                        <a class="btn btn-outline-secondary @(dimensaoAtiva == dimensao ? "active" : "")"
                           asp-page="/Atendimentos"
                           asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                           asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                           asp-route-dimensao="@dimensao.ToString().ToLowerInvariant()"
                           asp-route-forma="@formaAtiva.ToString().ToLowerInvariant()">@dimensao</a>
                    }
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Forma do gráfico">
                    <a class="btn btn-outline-primary @(formaAtiva == GraficoForma.Coluna ? "active" : "")"
                       asp-page="/Atendimentos"
                       asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                       asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                       asp-route-dimensao="@rotuloDimensao">Coluna</a>
                    <a class="btn btn-outline-primary @(formaAtiva == GraficoForma.Linha ? "active" : "")"
                       asp-page="/Atendimentos"
                       asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                       asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                       asp-route-dimensao="@rotuloDimensao"
                       asp-route-forma="linha">Linha</a>
                    @if (dimensaoAtiva != DimensaoVisao.Nenhuma)
                    {
                        <a class="btn btn-outline-primary @(formaAtiva == GraficoForma.Donut ? "active" : "")"
                           asp-page="/Atendimentos"
                           asp-route-inicio="@Model.Periodo?.Start.ToString("yyyy-MM-dd")"
                           asp-route-fim="@Model.Periodo?.End.ToString("yyyy-MM-dd")"
                           asp-route-dimensao="@rotuloDimensao"
                           asp-route-forma="donut">Rosca</a>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="grafico-visao @(visao.Forma == GraficoForma.Donut ? "grafico-visao-rosca" : "")" id="grafico-visao" role="img" aria-label="Gráfico do indicador de Atendimentos"></div>
                <div class="mt-3" id="legenda-visao"></div>

                <details class="convenio-secao mt-3" id="analise-convenios">
                    <summary class="convenio-resumo">Análise por convênio</summary>
                    <div class="convenio-corpo mt-2">
                        @if (Model.ConvenioNominalIndisponivel)
                        {
                            <div class="alert alert-warning py-2 mb-0 small" role="alert">
                                Não foi possível carregar a análise por convênio. O indicador consolidado acima permanece válido.
                                <span class="d-block text-muted font-monospace mt-1">@Model.MensagemConvenioNominal</span>
                            </div>
                        }
                        else if (Model.ConvenioNominal is null || Model.ConvenioNominal.Convenios.Count == 0)
                        {
                            <div class="grafico-vazio">Sem dados no período.</div>
                        }
                        else
                        {
                            <div class="convenio-rolagem">
                                <div class="mb-3">
                                    <div class="h6 mb-2">Atendimentos por Convênio</div>
                                    @{
                                        decimal volumeMaximo = Model.ConvenioNominal.Convenios.Max(c => c.Volume);
                                        int alturaSvg = 16 + (Model.ConvenioNominal.Convenios.Count * 24);
                                        int linha = 0;
                                    }
                                    <svg viewBox="0 0 860 @alturaSvg" style="width:100%;height:auto;display:block;" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Gráfico horizontal: Atendimentos por Convênio">
                                        @foreach (var convenio in Model.ConvenioNominal.Convenios)
                                        {
                                            double largura = volumeMaximo > 0
                                                ? ((double)convenio.Volume / (double)volumeMaximo) * 470
                                                : 0;
                                            string larguraTexto = largura > 0
                                                ? largura.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
                                                : "0";
                                            int yLinha = 8 + linha * 24;
                                            string nomeRotulo = convenio.Identificacao;
                                            if (nomeRotulo.Length > 26)
                                            {
                                                nomeRotulo = nomeRotulo.Substring(0, 26) + "...";
                                            }
                                            <g>
                                                <text x="6" y="@(yLinha + 15)" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="12" fill="#212529">@nomeRotulo</text>
                                                @if (largura > 0)
                                                {
                                                    <rect x="240" y="@(yLinha + 5)" width="@larguraTexto" height="13" rx="2" fill="#0d6efd"></rect>
                                                }
                                                <text x="850" y="@(yLinha + 15)" text-anchor="end" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" font-size="12" fill="#212529">@convenio.Volume.ToString("N0")</text>
                                            </g>
                                            linha++;
                                        }
                                    </svg>
                                </div>
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Convênio</th>
                                            <th scope="col" class="text-end">Volume</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var convenio in Model.ConvenioNominal.Convenios)
                                        {
                                            <tr>
                                                <td>@convenio.Identificacao</td>
                                                <td class="text-end">@convenio.Volume.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </details>
            </div>
        </div>

        <script type="application/json" id="dados-visao">@Html.Raw(Model.DadosJson)</script>
    }
</div>

@section Scripts {
    <script src="~/js/atendimentos.js" asp-append-version="true"></script>
}
